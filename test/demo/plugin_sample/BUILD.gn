  sources = [
    "plugin_play_two_channe.cpp",
    "player_sample_common.cpp",
    ]
  cflags = [ "-Wall" ]
  cflags_cc = cflags
  include_dirs = [
    "${aafwk_lite_path}/interfaces/kits/ability_lite",
    "${appexecfwk_lite_path}/interfaces/kits/bundle_lite",
    "${aafwk_lite_path}/interfaces/kits/want_lite",
    "//drivers/peripheral/display/interfaces/include",
    "//foundation/multimedia/camera_lite/services/server/include",
    "//foundation/multimedia/camera_lite/services/impl/include",
    "//foundation/multimedia/camera_lite/services/impl/include",
  ]
  public_configs = [
    ":player_impl_external_library_config",
    ]

  ldflags = [ "-Wl,-Map=media_server.map" ]
  ldflags += [
    "-lstdc++",
    "-lcodec",
    "-laudio_hw",
    "-lformat_hw",
    "-lhdi_camera",
    "-ldisplay_layer",
    "-lpthread",
    "-Wl,-rpath-link=$ohos_root_path/$root_out_dir",
  ]
  deps = [
    "//foundation/multimedia/media_lite/services:camera_config",
    "//foundation/multimedia/media_lite/services:codec_config",
    "//foundation/multimedia/media_lite/services:media_config",
    "//foundation/multimedia/media_lite/services/player_lite:player_impl",
    "//foundation/multimedia/media_lite/services:media_server",
    "//foundation/multimedia/camera_lite/services:camera_server",
    "//foundation/multimedia/media_lite/services/recorder_lite:recorder_impl",
    "//foundation/multimedia/media_lite/services/recorder_lite:recorder_server",
  ]
  output_dir = "$root_out_dir/usr"
